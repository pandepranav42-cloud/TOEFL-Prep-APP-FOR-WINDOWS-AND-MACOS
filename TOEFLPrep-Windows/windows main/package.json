{
  "name": "toefl-prep",
  "productName": "TOEFL Prep",
  "version": "1.0.0",
  "description": "TOEFL vocabulary and reading preparation — offline.",
  "author": {
    "name": "Pranav Pande",
    "email": "pandepranav42@hotmail.com"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.toeflprep.app",
    "productName": "TOEFL Prep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TOEFL Prep"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "icon": "build/icon.png"
    }
  }
}
